#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define NUMBERS 1
#define SYMBOLS 2
#define MEDIA 3
#define MODIFY 4
#define BLUETOOTH 5

&lt {
    flavor = "hold-preferred";
};

/ {
        keymap {
                compatible = "zmk,keymap";

         layer0 {
                label = "DEFAULT";
              bindings = <
  &kp LEFT_BRACKET  &kp Q  &kp W  &kp E         &kp R        &kp T        &kp Y          &kp U       &kp I          &kp O    &kp P          &kp RIGHT_BRACKET
  &lt 1 TAB         &kp A  &kp S  &kp D         &kp F        &kp G        &kp H          &kp J       &kp K          &kp L    &kp SEMICOLON  &kp SINGLE_QUOTE
  &kp LEFT_SHIFT    &kp Z  &kp X  &kp C         &kp V        &kp B        &kp N          &kp M       &kp COMMA      &kp DOT  &kp SLASH      &mo 2
                                  &kp LEFT_ALT  &kp LCTRL    &lt 4 ENTER  &kp SPACE      &kp BACKSPACE  &kp DELETE  
              >;
          };
  
          layer1 {
                label = "NUMBER";
              bindings = <
  &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans    &trans  &trans  &trans
              >;
          };
  
          layer2 {
                label = "SYMBOL";
              bindings = <
  &kp GRAVE  &trans     &trans    &trans    &trans    &trans       &to 6     &trans     &trans  &trans  &trans  &kp BACKSLASH
  &trans     &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp EQUAL  &kp PLUS   &trans  &trans  &trans  &trans
  &trans     &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR     &kp MINUS  &kp UNDER  &trans  &trans  &trans  &trans
                                  &trans    &trans    &trans       &trans     &trans     &trans
              >;
          };
  
          layer3 {
                label = "MEDIA";
              bindings = <
  &kp F1  &kp F2          &kp F3             &kp F4           &kp F5      &kp F6              &kp F7      &kp F8    &kp F9         &kp F10  &kp F11  &kp F12
  &to 0   &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &none               &kp INSERT  &kp HOME  &kp PAGE_UP    &none    &none    &trans
  &trans  &trans          &none              &none            &none       &none               &kp DELETE  &kp END   &kp PAGE_DOWN  &none    &none    &to 0
                                             &trans           &trans      &kp C_PLAY_PAUSE    &kp C_MUTE  &trans    &to 0
              >;
          };
  
          layer4 {
                label = "MODIFY";
              bindings = <
  &kp LS(LBRC)  &trans     &trans  &trans        &trans     &kp ESCAPE    &trans  &trans          &trans    &kp LS(N9)        &kp LS(N0)     &kp LS(RBRC)
  &trans    &kp LS(A)  &trans  &trans        &trans     &trans        &trans  &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans
  &trans    &trans     &trans  &trans        &kp LS(V)  &to 5         &trans  &to 3           &trans    &trans        &trans     &trans
                               &kp LEFT_GUI  &trans     &trans        &trans  &kp DEL         &trans
              >;
          };
               
               
                 layer5 {
                        label = "BLU2TH";
                        bindings = <
   &none  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
   &none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
   &none  &none  &none  &bt BT_CLR  &none  &none    &none  &none  &none  &none  &none  &none
                  &trans &trans &to DEFAULT    &to DEFAULT &none &to DEFAULT
                        >;
                };

        };

                layer6 {
                        label = "GAMER";
                        bindings = <
   &kp ESC  &trans &trans  &trans  &trans &trans    &kp F1      &kp F1      &kp F3       &kp F4      &kp F5      &kp F6
   &kp TAB  &trans &trans  &trans  &trans &trans    &none  &none  &none  &none  &none  &none
   &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp B   &none  &none  &none  &none  &none  &none
                  &mo 7 &trans &kp SPACE            &kp ENTER &to DEFAULT &to DEFAULT
                        >;
                };

        };

        layer7 {
                label = "GAMER2";
              bindings = <
  &trans    &trans     &trans   &trans    &trans     &trans        &trans    &trans     &trans  &trans    &trans     &trans
  &trans    &trans      &trans  &trans    &trans     &trans   &trans    &trans     &trans  &trans    &trans     &trans
  &kp LCTRL &kp Z       &kp X    &kp C    &kp V      &kp N5     &trans    &trans     &trans  &trans    &trans     &trans
                               &trans  &trans     &trans        &trans      &trans         &trans
              >;
          };
};
